    "codes": {
      "ADDACCT": "an additional account is opened for an existing customer; the account becomes active",
      "CLOSEACCT": "an account is closed; the account becomes inactive",
      "INACT": "a customer becomes inactive",
      "NEW": "a new customer is recorded together with their first account; both become active",
      "UPDACCT": "an existing account's details change; the account stays open",
      "UPDCUST": "an existing customer's details change; the customer stays active"
    },
    "entity_subjects": {
      "logical.account": "account",
      "logical.customer": "customer"
    },
    "note": "What each received CustomerMgmt action code means, as the source defines it. Using this meaning to derive a statement's status is interpreting a named reference, not inventing policy. The clause locator is unverified; see the adjudication.",
